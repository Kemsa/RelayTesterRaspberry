{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A relay configuration",
  "definitions": {
    "coilToMeasure": {
      "type": "number",
      "enum": [1, 2]
    },
    "coilToPower": {
      "type": "number",
      "enum": [0, 1, 2]
    },
    "coilVoltage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6000
    },
    "coilCurrent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000,
      "default": 200
    },
    "nContacts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "nMeasures": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 16
    },
    "nCycles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 3
    },
    "time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "contactVoltage_mV": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "coilResistanceMeasure": {
      "type": "object",
      "properties": {
        "measureType": { "const": "coilResistance" },
        "coilToMeasure": { "$ref": "#/definitions/coilToMeasure" },
        "supplyVoltage_cV": { "$ref": "#/definitions/coilVoltage" },
        "maxCurrent_mA": { "$ref": "#/definitions/coilCurrent" },
        "nMeasures": { "$ref": "#/definitions/nMeasures" },
        "successValues": {
          "type": "object",
          "properties": {
            "minResistance_ohm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10e6
            },
            "maxResistance_ohm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10e6
            }
          },
          "required": ["minResistance_ohm", "maxResistance_ohm"]
        }
      },
      "required": [
        "measureType",
        "coilToMeasure",
        "supplyVoltage_cV",
        "successValues"
      ]
    },
    "switchingVoltageMeasure": {
      "type": "object",
      "properties": {
        "measureType": { "const": "switchingVoltage" },
        "coilToMeasure": { "$ref": "#/definitions/coilToMeasure" },
        "nContacts": { "$ref": "#/definitions/nContacts" },
        "startVoltage_cV": { "$ref": "#/definitions/coilVoltage" },
        "stopVoltage_cV": { "$ref": "#/definitions/coilVoltage" },
        "voltageStep_cV": { "$ref": "#/definitions/coilVoltage" },
        "maxCurrent_mA": { "$ref": "#/definitions/coilCurrent" },
        "nMeasures": { "$ref": "#/definitions/nMeasures" },
        "successValues": {
          "type": "object",
          "properties": {
            "maxSwitchingVoltage_cV": { "$ref": "#/definitions/coilVoltage" }
          },
          "required": ["maxSwitchingVoltage_cV"]
        }
      },
      "required": [
        "measureType",
        "coilToMeasure",
        "nContacts",
        "startVoltage_cV",
        "stopVoltage_cV",
        "voltageStep_cV",
        "successValues"
      ]
    },
    "cutVoltageMeasure": {
      "type": "object",
      "properties": {
        "measureType": { "const": "cutVoltage" },
        "coilToMeasure": { "$ref": "#/definitions/coilToMeasure" },
        "nContacts": { "$ref": "#/definitions/nContacts" },
        "startVoltage_cV": { "$ref": "#/definitions/coilVoltage" },
        "stopVoltage_cV": { "$ref": "#/definitions/coilVoltage" },
        "voltageStep_cV": { "$ref": "#/definitions/coilVoltage" },
        "maxCurrent_mA": { "$ref": "#/definitions/coilCurrent" },
        "nMeasures": { "$ref": "#/definitions/nMeasures" },
        "successValues": {
          "type": "object",
          "properties": {
            "minCutVoltage_cV": { "$ref": "#/definitions/coilVoltage" }
          },
          "required": ["minCutVoltage_cV"]
        }
      },
      "required": [
        "measureType",
        "coilToMeasure",
        "nContacts",
        "startVoltage_cV",
        "stopVoltage_cV",
        "voltageStep_cV",
        "successValues"
      ]
    },
    "contactResistanceMeasure": {
      "type": "object",
      "properties": {
        "measureType": { "const": "contactResistance" },
        "coilToPowerOn": { "$ref": "#/definitions/coilToPower" },
        "coilToPowerOff": { "$ref": "#/definitions/coilToPower" },
        "contactDirection": {
          "type": "string",
          "enume": ["On", "Off", "both"]
        },
        "nContacts": { "$ref": "#/definitions/nContacts" },
        "supplyVoltage_cV": { "$ref": "#/definitions/coilVoltage" },
        "maxCurrent_mA": { "$ref": "#/definitions/coilCurrent" },
        "nMeasures": { "$ref": "#/definitions/nMeasures" },
        "nCycles": { "$ref": "#/definitions/nCycles" },
        "successValues": {
          "type": "object",
          "properties": {
            "maxResistanceClosed_mOhm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10e6
            }
          },
          "required": ["maxResistanceClosed_mOhm"]
        }
      },
      "required": [
        "measureType",
        "coilToPowerOn",
        "coilToPowerOff",
        "contactDirection",
        "nContacts",
        "supplyVoltage_cV",
        "successValues"
      ]
    },
    "switchingTimeMeasure": {
      "type": "object",
      "properties": {
        "measureType": { "const": "switchingTime" },
        "coilToPowerOn": { "$ref": "#/definitions/coilToPower" },
        "coilToPowerOff": { "$ref": "#/definitions/coilToPower" },
        "nContacts": { "$ref": "#/definitions/nContacts" },
        "switchCount": { "type": "integer", "minimum": 1, "maximum": 255 },
        "supplyVoltage_cV": { "$ref": "#/definitions/coilVoltage" },
        "maxCurrent_mA": { "$ref": "#/definitions/coilCurrent" },
        "successValues": {
          "type": "object",
          "properties": {
            "maxWorkTime_ms": { "$ref": "#/definitions/time_ms" },
            "maxWorkTimeRebound_ms": { "$ref": "#/definitions/time_ms" },
            "maxCutTime_ms": { "$ref": "#/definitions/time_ms" },
            "maxCutTimeRebound_ms": { "$ref": "#/definitions/time_ms" }
          },
          "required": [
            "maxWorkTime_ms",
            "maxWorkTimeRebound_ms",
            "maxCutTime_ms",
            "maxCutTimeRebound_ms"
          ]
        }
      },
      "required": [
        "measureType",
        "coilToPowerOn",
        "coilToPowerOff",
        "nContacts",
        "switchCount",
        "supplyVoltage_cV",
        "successValues"
      ]
    },
    "selfTestResistanceMeasure": {
      "type": "object",
      "properties": {
        "measureType": { "const": "selfTestResistance" },
        "contact": { "type": "number", "enum": [1, 2, 3, 4, 5, 6, 7, 8] },
        "subContact": { "type": "string", "enum": ["NO", "NC"] },
        "nMeasures": { "$ref": "#/definitions/nMeasures" },
        "successValues": {
          "type": "object",
          "properties": {
            "targetResistance_ohm": {
              "type": "number",
              "minimum": 0
            },
            "targetdeviation_ohm": {
              "type": "number",
              "minimum": 0,
              "maximum": 101e6
            }
          },
          "required": ["targetResistance_ohm", "targetdeviation_ohm"]
        }
      },
      "required": ["measureType", "contact", "subContact", "successValues"]
    }
  },
  "properties": {
    "relayBrand": {
      "type": "string"
    },
    "relayModel": {
      "type": "string"
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "parameters": {
            "type": "object",
            "oneOf": [
              { "$ref": "#/definitions/coilResistanceMeasure" },
              { "$ref": "#/definitions/switchingVoltageMeasure" },
              { "$ref": "#/definitions/cutVoltageMeasure" },
              { "$ref": "#/definitions/contactResistanceMeasure" },
              { "$ref": "#/definitions/switchingTimeMeasure" },
              { "$ref": "#/definitions/selfTestResistanceMeasure" }
            ]
          }
        },
        "required": ["name", "parameters"]
      }
    }
  },
  "required": ["relayBrand", "relayModel", "measures"]
}
