{
  "$schema": "../relay_schema.json",
  "relayBrand": "TEC",
  "relayModel": "TEC1804880B00",
  "description": "Relais TEC 1804880B00:\n- monostable\n- 24V\n- 4 voies",
  "measures": [
    {
      "name": "resistance de bobine",
      "parameters": {
        "measureType": "coilResistance",
        "coilToMeasure": 1,
        "supplyVoltage_cV": 5e2,
        "successValues": {
          "minResistance_ohm": 400,
          "maxResistance_ohm": 550
        }
      }
    },
    {
      "name": "tension de commutation",
      "parameters": {
        "measureType": "switchingVoltage",
        "coilToMeasure": 1,
        "nContacts": 4,
        "startVoltage_cV": 10e2,
        "stopVoltage_cV": 28e2,
        "voltageStep_cV": 100,
        "successValues": {
          "maxSwitchingVoltage_cV": 24e2
        }
      }
    },
    {
      "name": "tension de relachement",
      "parameters": {
        "measureType": "cutVoltage",
        "coilToMeasure": 1,
        "nContacts": 4,
        "startVoltage_cV": 28e2,
        "stopVoltage_cV": 5e2,
        "voltageStep_cV": 100,
        "successValues": {
          "minCutVoltage_cV": 10e2
        }
      }
    },
    {
      "name": "resistance de contact",
      "parameters": {
        "measureType": "contactResistance",
        "coilToPowerOn": 1,
        "coilToPowerOff": 0,
        "contactDirection": "both",
        "nContacts": 4,
        "nMeasures": 4,
        "supplyVoltage_cV": 24e2,
        "successValues": {
          "maxResistanceClosed_mOhm": 5000
        }
      }
    },
    {
      "name": "temps de commutation",
      "parameters": {
        "measureType": "switchingTime",
        "coilToPowerOn": 1,
        "coilToPowerOff": 0,
        "nContacts": 4,
        "switchCount": 20,
        "supplyVoltage_cV": 24e2,
        "successValues": {
          "maxWorkTime_no_ms": 11.5,
          "maxCutTime_no_ms": 2.5,
          "maxWorkTime_nc_ms": 8,
          "maxCutTime_nc_ms": 5
        }
      }
    }
  ]
}
